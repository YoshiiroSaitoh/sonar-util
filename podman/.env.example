# Copy this file to .env and replace the password before starting the stack.
# Do not commit podman/.env.
SONAR_DB_NAME=sonarqube
SONAR_DB_USER=sonarqube
SONAR_DB_PASSWORD=replace-with-a-long-random-password

# Optional overrides. Pin these to an exact release when reproducibility matters.
SONARQUBE_IMAGE=docker.io/library/sonarqube:community
POSTGRES_IMAGE=docker.io/library/postgres:17-alpine
SONAR_HOST_PORT=9000

