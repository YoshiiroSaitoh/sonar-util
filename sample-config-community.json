{
  "rootPath": "E:\\dev\\workspace\\sonarqubetool\\testdata",
  "projectKeyPrefix": "test",
  "projectName": {
    "mode": "relativePath",
    "separator": " / ",
    "includePrefix": true,
    "prefixSeparator": " / "
  },
  "sonar": {
    "propertiesFile": "sonar-community.properties",
    "applicationKey": null
  },
  "scanner": {
    "executable": "sonar-scanner.bat",
    "parallelism": 4,
    "javaBinaries": {
      "directory": "classes",
      "useDummyWhenMissing": true
    },
    "logs": {
      "directory": "logs"
    }
  },
  "splitDirectories": [],
  "excludeDirectories": [
    ".git",
    "node_modules",
    "bin",
    "obj"
  ],
  "allowDelete": true,
  "deleteOnlyCreatedByTool": true
}
